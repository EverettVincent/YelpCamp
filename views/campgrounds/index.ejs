<!-- index.ejs -->
<% layout("layouts/boilerplate.ejs") %>

<h1>All Campgrounds</h1>
<div>
  <a href="/campgrounds/new">Add A Campground</a>
</div>

  <% for (let campground in allCampgrounds) { %>
      <div class="card" mb-3>
        <div class="row">
          <div class="col-md-4">
            <img class="img-fluid" alt="" src=" <%=  allCampgrounds[campground].image %> ">
          </div>
          <div class="col-md-8">
            <div class="card-body">
              <h5 class="card-title"><%= allCampgrounds[campground]["title"]  %></h5>
              <p class="card-text"><%=    allCampgrounds[campground]["description"]    %></p>
              <p class="card-text">
                <small class="text-muted">
                  <%= allCampgrounds[campground]["location"]   %>
                </small>
              </p>
              <a href="/campgrounds/<%=  allCampgrounds[campground]["_id"]  %>" class="btn btn-primary">View <%= allCampgrounds[campground]["title"] %></a>
            </div>
          </div>
        </div>
      </div>
  <% } %>

 