<!-- views/campgrounds/new.ejs -->
<% layout("layouts/boilerplate.ejs") %>

<div class="row">
  <h1 class="text-center">New Campground</h1>
  <div class="col-6 offset-3">

    <form action="/campgrounds" method="POST" novalidate class="validated-form">
      <div class="mb-2">
        <label for="title" class="form-label">Campground Title</label>
        <input type="text" id="title" name="formTitle" placeholder="campground's title........." class="form-control" required>
        <div class="valid-feedback">
          Looks good!
        </div>
      </div>
      <div class="mb-2">
        <label for="location" class="form-label">Location</label>
        <input type="text" id="location" name="formLocation" placeholder="a location.........." class="form-control" required>
      </div>
      <div class="mb-2">
        <label for="image" class="form-label">Image Url</label>
        <input type="text" id="image" name="formImage" placeholder="url of a picture.........." class="form-control" required>
      </div>
      <div class="mb-2">
        <label for="price" class="form-label">Campground Price</label>
        <div class="input-group">
          <span class="input-group-text" id="price-label">$</span>
          <input type="text" id="price" name="formPrice" placeholder="0.00" class="form-control" aria-label="price" aria-describedby="price-label" required>
        </div>
      </div>
      <div class="mb-2">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" name="formDescription" placeholder="add a description.........." class="form-control" required></textarea>
      </div>
      <div class="mt-3 mb-3">
        <button class="btn btn-success">Add Campground</button>
      </div>
    </form>

  <a href="/campgrounds">Back To All Campgrounds</a>
  </div>
</div>