<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ALL CAMPGROUNDS</title>
</head>
<body>
  <h1>All Campgrounds</h1>
  <div>
    <a href="/campgrounds/new">Add A Campground</a>
  </div>
  <ul>
    <% for (let campground in allCampgrounds) { %>
      <li>
        <a href="/campgrounds/<%= allCampgrounds[campground]._id %>"> <%= allCampgrounds[campground]["title"] %> </a>
      </li>
    <% } %>
  </ul>
</body>
</html>